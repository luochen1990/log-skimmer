2026-10-16T01:23:06.0837105Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-16T01:23:06.0837403Z 
2026-10-16T01:23:06.0837652Z # To enable the settings / commands in this file for login shells as well,
2026-10-16T01:23:06.0839163Z # this file has to be sourced in /etc/profile.
2026-10-16T01:23:06.0839647Z 
2026-10-16T01:23:06.0839975Z # If not running interactively, don't do anything
2026-10-16T01:23:06.0840752Z [ -z "$PS1" ] && return
2026-10-16T01:23:06.0841120Z 
2026-10-16T01:23:06.0841540Z # check the window size after each command and, if necessary,
2026-10-16T01:23:06.0842460Z # update the values of LINES and COLUMNS.
2026-10-16T01:23:06.0843166Z shopt -s checkwinsize
2026-10-16T01:23:06.0843488Z 
2026-10-16T01:23:06.0843945Z # set variable identifying the chroot you work in (used in the prompt below)
