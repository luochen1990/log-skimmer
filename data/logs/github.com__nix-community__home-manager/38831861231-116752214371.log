2026-10-16T00:51:36.9494435Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-16T00:51:36.9495244Z 
2026-10-16T00:51:36.9495689Z # To enable the settings / commands in this file for login shells as well,
2026-10-16T00:51:36.9496605Z # this file has to be sourced in /etc/profile.
2026-10-16T00:51:36.9497043Z 
2026-10-16T00:51:36.9497334Z # If not running interactively, don't do anything
2026-10-16T00:51:36.9498005Z [ -z "$PS1" ] && return
2026-10-16T00:51:36.9498317Z 
2026-10-16T00:51:36.9498663Z # check the window size after each command and, if necessary,
2026-10-16T00:51:36.9499441Z # update the values of LINES and COLUMNS.
