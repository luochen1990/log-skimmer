2026-10-04T19:12:34.8456229Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-04T19:12:34.8456683Z 
2026-10-04T19:12:34.8457030Z # To enable the settings / commands in this file for login shells as well,
2026-10-04T19:12:34.8458001Z # this file has to be sourced in /etc/profile.
2026-10-04T19:12:34.8458350Z 
2026-10-04T19:12:34.8458487Z # If not running interactively, don't do anything
2026-10-04T19:12:34.8459078Z [ -z "$PS1" ] && return
2026-10-04T19:12:34.8459228Z 
2026-10-04T19:12:34.8459434Z # check the window size after each command and, if necessary,
2026-10-04T19:12:34.8459823Z # update the values of LINES and COLUMNS.
2026-10-04T19:12:34.8460147Z shopt -s checkwinsize
2026-10-04T19:12:34.8460322Z 
2026-10-04T19:12:34.8460611Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-04T19:12:34.8461078Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-04T19:12:34.8461435Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-04T19:12:34.8461701Z fi
2026-10-04T19:12:34.8461799Z 
2026-10-04T19:12:34.8461979Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-04T19:12:34.8462429Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-04T19:12:34.8462831Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-04T19:12:34.8463158Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-04T19:12:34.8463445Z fi
2026-10-04T19:12:34.8463536Z 
