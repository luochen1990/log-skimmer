2026-10-04T18:58:17.1352701Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-04T18:58:17.1353131Z 
2026-10-04T18:58:17.1353545Z # To enable the settings / commands in this file for login shells as well,
2026-10-04T18:58:17.1354247Z # this file has to be sourced in /etc/profile.
2026-10-04T18:58:17.1354608Z 
2026-10-04T18:58:17.1354815Z # If not running interactively, don't do anything
2026-10-04T18:58:17.1355331Z [ -z "$PS1" ] && return
2026-10-04T18:58:17.1355861Z 
2026-10-04T18:58:17.1356140Z # check the window size after each command and, if necessary,
2026-10-04T18:58:17.1356744Z # update the values of LINES and COLUMNS.
2026-10-04T18:58:17.1357224Z shopt -s checkwinsize
2026-10-04T18:58:17.1357451Z 
2026-10-04T18:58:17.1357809Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-04T18:58:17.1358592Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-04T18:58:17.1359219Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-04T18:58:17.1359660Z fi
2026-10-04T18:58:17.1359825Z 
2026-10-04T18:58:17.1360132Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-04T18:58:17.1360596Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-04T18:58:17.1361373Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-04T18:58:17.1361710Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-04T18:58:17.1361994Z fi
2026-10-04T18:58:17.1362090Z 
2026-10-04T18:58:17.1362509Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-04T18:58:17.1363186Z # If this is an xterm set the title to user@host:dir
