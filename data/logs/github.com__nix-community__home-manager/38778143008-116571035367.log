2026-10-15T17:32:26.5500204Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-15T17:32:26.5500402Z 
2026-10-15T17:32:26.5500630Z # To enable the settings / commands in this file for login shells as well,
2026-10-15T17:32:26.5501013Z # this file has to be sourced in /etc/profile.
2026-10-15T17:32:26.5501203Z 
2026-10-15T17:32:26.5501311Z # If not running interactively, don't do anything
2026-10-15T17:32:26.5501591Z [ -z "$PS1" ] && return
2026-10-15T17:32:26.5501721Z 
2026-10-15T17:32:26.5501869Z # check the window size after each command and, if necessary,
2026-10-15T17:32:26.5502425Z # update the values of LINES and COLUMNS.
2026-10-15T17:32:26.5502670Z shopt -s checkwinsize
2026-10-15T17:32:26.5502796Z 
2026-10-15T17:32:26.5502976Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-15T17:32:26.5503341Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-15T17:32:26.5503615Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-15T17:32:26.5503825Z fi
2026-10-15T17:32:26.5503907Z 
2026-10-15T17:32:26.5504047Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-15T17:32:26.5504388Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-15T17:32:26.5504738Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-15T17:32:26.5504997Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-15T17:32:26.5505221Z fi
2026-10-15T17:32:26.5505304Z 
2026-10-15T17:32:26.5506591Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-15T17:32:26.5507159Z # If this is an xterm set the title to user@host:dir
2026-10-15T17:32:26.5507538Z #case "$TERM" in
