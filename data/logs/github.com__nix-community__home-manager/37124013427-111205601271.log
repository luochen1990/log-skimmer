2026-10-03T12:47:48.3830436Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-03T12:47:48.3830865Z 
2026-10-03T12:47:48.3831200Z # To enable the settings / commands in this file for login shells as well,
2026-10-03T12:47:48.3831926Z # this file has to be sourced in /etc/profile.
2026-10-03T12:47:48.3832290Z 
2026-10-03T12:47:48.3832502Z # If not running interactively, don't do anything
2026-10-03T12:47:48.3833017Z [ -z "$PS1" ] && return
2026-10-03T12:47:48.3833532Z 
2026-10-03T12:47:48.3833806Z # check the window size after each command and, if necessary,
2026-10-03T12:47:48.3834416Z # update the values of LINES and COLUMNS.
2026-10-03T12:47:48.3834903Z shopt -s checkwinsize
2026-10-03T12:47:48.3835138Z 
2026-10-03T12:47:48.3835496Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-03T12:47:48.3836292Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-03T12:47:48.3836891Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-03T12:47:48.3837349Z fi
2026-10-03T12:47:48.3837512Z 
2026-10-03T12:47:48.3838051Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-03T12:47:48.3838551Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-03T12:47:48.3838983Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-03T12:47:48.3839317Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-03T12:47:48.3839624Z fi
2026-10-03T12:47:48.3839731Z 
2026-10-03T12:47:48.3839938Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-03T12:47:48.3840712Z # If this is an xterm set the title to user@host:dir
