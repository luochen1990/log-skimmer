2026-10-05T01:18:09.0283638Z # System-wide .bashrc file for interactive bash(1) shells.
2026-10-05T01:18:09.0283871Z 
2026-10-05T01:18:09.0284066Z # To enable the settings / commands in this file for login shells as well,
2026-10-05T01:18:09.0284462Z # this file has to be sourced in /etc/profile.
2026-10-05T01:18:09.0284667Z 
2026-10-05T01:18:09.0284787Z # If not running interactively, don't do anything
2026-10-05T01:18:09.0285080Z [ -z "$PS1" ] && return
2026-10-05T01:18:09.0285223Z 
2026-10-05T01:18:09.0285382Z # check the window size after each command and, if necessary,
2026-10-05T01:18:09.0285982Z # update the values of LINES and COLUMNS.
2026-10-05T01:18:09.0286266Z shopt -s checkwinsize
2026-10-05T01:18:09.0286403Z 
2026-10-05T01:18:09.0286622Z # set variable identifying the chroot you work in (used in the prompt below)
2026-10-05T01:18:09.0287089Z if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
2026-10-05T01:18:09.0287436Z     debian_chroot=$(cat /etc/debian_chroot)
2026-10-05T01:18:09.0287714Z fi
2026-10-05T01:18:09.0287808Z 
2026-10-05T01:18:09.0287993Z # set a fancy prompt (non-color, overwrite the one in /etc/profile)
2026-10-05T01:18:09.0288437Z # but only if not SUDOing and have SUDO_PS1 set; then assume smart user.
2026-10-05T01:18:09.0288859Z if ! [ -n "${SUDO_USER}" -a -n "${SUDO_PS1}" ]; then
2026-10-05T01:18:09.0289222Z   PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
2026-10-05T01:18:09.0289508Z fi
2026-10-05T01:18:09.0289603Z 
2026-10-05T01:18:09.0289806Z # Commented out, don't overwrite xterm -T "title" -n "icontitle" by default.
2026-10-05T01:18:09.0290505Z # If this is an xterm set the title to user@host:dir
2026-10-05T01:18:09.0290797Z #case "$TERM" in
2026-10-05T01:18:09.0290993Z #xterm*|rxvt*)
2026-10-05T01:18:09.0291294Z #    PROMPT_COMMAND='echo -ne "\033]0;${USER}@${HOSTNAME}: ${PWD}\007"'
2026-10-05T01:18:09.0291648Z #    ;;
2026-10-05T01:18:09.0291816Z #*)
2026-10-05T01:18:09.0291997Z #    ;;
